# 复制为 .env 后填写 API key。请保留已有 .env 中的配置和密钥。
# 检查配置：python launch_agents.py --check
# 启动全部：python launch_agents.py
# 仅启动一个已配置的 agent：python launch_agents.py --agent calculator

# ===== 公共模型配置 =====
# 当前使用 DeepSeek 的 Anthropic 兼容接口，因此变量名保留 ANTHROPIC_ 前缀。
# 所有 agent 共用这些设置；MODEL_ID 请填写你账号实际可用的模型名称。
ANTHROPIC_API_KEY=
MODEL_ID=deepseek-v4-flash
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# ===== 启动名单与 comm 通信 =====
# 真实通信后端要求 Python 3.14+，macOS/Linux；Windows 不支持。
# 每个 agent 使用独立进程。默认启动三个 agent。
# 如果只需要一个，将下面一行改为 AGENTS=calculator 即可，其他 agent 的配置可以保留。
AGENTS=calculator,reviewer,observer

# 启动时预先创建的 topic；各 agent 后续仍可通过工具创建和加入其他 topic。
TOPICS=tasks,drafts,results,audit
# 留空自动选择本机 IPv4 并发现局域网节点；127.0.0.1 仅同机通信。
COMM_HOST=
# 可选，逗号分隔的已有 Comm 节点地址；默认无需配置，无中心服务。
COMM_SEEDS=
COMM_TIMEOUT=5
# 等待同组全部 agent 加入 topic 后再开始模型调用，单位秒。
AGENT_STARTUP_TIMEOUT=60

# ===== 每个 agent 的配置 =====
# 名称对应大写变量前缀，例如 calculator -> AGENT_CALCULATOR_。
# 名称仅使用英文字母、数字、下划线或连字符，以英文字母开头；连字符映射为下划线。
# WORKDIR 和 INITIAL_PROMPT 必填；TOPICS 可省略或留空，表示启动时不订阅任何 topic。
# 各工作目录必须不同。相对路径以本 .env 所在目录为基准，Windows 路径建议使用 /。
# 文件工具仅允许访问各自工作目录；历史、日志、记忆和定时任务也保存在各自目录内。
# 不需要另设公共 AGENT_WORKDIR，启动器会为每个进程自动设置。

# --- 计算 agent ---
AGENT_CALCULATOR_WORKDIR=./workspaces/calculator
AGENT_CALCULATOR_TOPICS=tasks,drafts,results
AGENT_CALCULATOR_INITIAL_PROMPT="你是计算 agent。
启动后等待 tasks 中的计算任务，将任务标识、计算过程和结果作为字符串发送到 drafts，交给 reviewer 复核。
收到 results 的反馈后按需更正。可使用文件工具在自己的工作目录中保存任务记录。
通过 topic 消息协作，完成当前任务后等待，不使用工具轮询或休眠。"

# --- 复核 agent ---
AGENT_REVIEWER_WORKDIR=./workspaces/reviewer
AGENT_REVIEWER_TOPICS=drafts,results
AGENT_REVIEWER_INITIAL_PROMPT="你是复核 agent。
启动后等待 drafts 中的计算结果，独立验证，把任务标识、验证结论和正确结果作为字符串发送到 results。
不要复核自己发出的消息。完成当前任务后等待。"

# --- 记录 agent ---
AGENT_OBSERVER_WORKDIR=./workspaces/observer
AGENT_OBSERVER_TOPICS=tasks,drafts,results,audit
# 初始提示词用双引号包裹，支持多行。
AGENT_OBSERVER_INITIAL_PROMPT="你是记录 agent。
启动后等待消息，使用 read_file、write_file、edit_file 将 tasks、drafts、results 中的任务进展记录到自己工作目录的 journal.md。
不重复记录自己发出的消息。只在需要报告记录情况时向 audit 发送字符串消息，完成后等待。"
